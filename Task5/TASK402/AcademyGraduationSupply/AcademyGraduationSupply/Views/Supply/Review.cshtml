@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    <h2>Review Selected Offers</h2>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Supplier</th>
                <th>Offer Name</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Price</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>Graduation Certificates</td>
                <td>@ViewBag.CertificateSupplier</td>
                <td>@ViewBag.CertificateOffer</td>
                <td>@ViewBag.CertificateQuantity</td>
                <td>@ViewBag.CertificatePrice JD</td>
                <td>@ViewBag.CertificateTotal JD</td>
            </tr>

            <tr>
                <td>Hospitality</td>
                <td>@ViewBag.HospitalitySupplier</td>
                <td>@ViewBag.HospitalityOffer</td>
                <td>@ViewBag.HospitalityQuantity</td>
                <td>@ViewBag.HospitalityPrice JD</td>
                <td>@ViewBag.HospitalityTotal JD</td>
            </tr>

            <tr>
                <td>Graduation Gifts</td>
                <td>@ViewBag.GiftSupplier</td>
                <td>@ViewBag.GiftOffer</td>
                <td>@ViewBag.GiftQuantity</td>
                <td>@ViewBag.GiftPrice JD</td>
                <td>@ViewBag.GiftTotal JD</td>
            </tr>
        </tbody>
    </table>

    <h3>Request Summary</h3>

    <p>Total Price: @ViewBag.TotalPrice JD</p>

    <p>Discount: @ViewBag.DiscountPercentage%</p>

    <p>Discount Amount: @ViewBag.DiscountAmount JD</p>

    <h4>Final Total: @ViewBag.FinalTotal JD</h4>

    <a href="@Url.Action("Index", "Supply")"
       class="btn btn-secondary">
        Back to Offers
    </a>

}
