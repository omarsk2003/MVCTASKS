@{
    Layout = "_MainLayout";

}
@{
<h1>@ViewBag.PageTitle</h1>
<p>Number of Suppliers: @ViewBag.NumberOfSuppliers</p>
<ul>
    @foreach (var supplier in ViewBag.SupplierNames)
    {
        <li>@supplier</li>
    }
</ul>
}
