    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_MainLayout";
}
@{
    <h1>@ViewBag.PageTitle</h1>
    <p>Number of Products: @ViewBag.NumberOfProducts</p>
    <ul>
        @foreach (string product in (string[])ViewBag.Categories)
        {
            <li>@product</li>
        }
    </ul>
}
