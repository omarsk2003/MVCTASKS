@model IEnumerable<TASK8.Models.Product>
@{ ViewData["Title"] = "Products"; }
<h2>Products</h2>
@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
{
    <a class="btn btn-primary mb-3" asp-action="Create">Add Product</a>
}
<table class="table table-bordered table-striped">
    <thead><tr><th>Name</th><th>Description</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td><td>@item.Description</td><td>@item.Price.ToString("0.00")</td><td>@item.Quantity</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a class="ms-2" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link text-danger" onclick="return confirm('Delete this product?')">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
