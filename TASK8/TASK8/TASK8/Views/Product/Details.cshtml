@model TASK8.Models.Product
@{ ViewData["Title"] = "Product Details"; }
@if (Model == null) { <p>Product not found.</p> }
else
{
    <h2>Product Details</h2>
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price.ToString("0.00")</dd>
        <dt class="col-sm-3">Stock</dt><dd class="col-sm-9">@Model.Quantity</dd>
    </dl>
    <a asp-action="Index">Back</a>
}
