@model TASK8.Models.Product
@{ ViewData["Title"] = "Add Product"; }
<h2>Add Product</h2>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label>Name</label><input asp-for="Name" class="form-control mb-2" />
    <label>Description</label><input asp-for="Description" class="form-control mb-2" />
    <label>Price</label><input asp-for="Price" type="number" step="0.01" min="0" class="form-control mb-2" />
    <label>Quantity</label><input asp-for="Quantity" type="number" min="0" class="form-control mb-2" />
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
