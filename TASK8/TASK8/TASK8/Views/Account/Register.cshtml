@model TASK8.Models.RegisterDTO
@{ ViewData["Title"] = "Register"; }
<h2>Register</h2>
<form asp-controller="Account" asp-action="Register" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label class="form-label">Full Name</label>
    <input asp-for="FullName" class="form-control mb-3" />
    <label class="form-label">Email</label>
    <input asp-for="Email" class="form-control mb-3" />
    <label class="form-label">Password</label>
    <input asp-for="Password" class="form-control mb-3" />
    <label class="form-label">Confirm Password</label>
    <input asp-for="ConfirmPassword" class="form-control mb-3" />
    <button type="submit" class="btn btn-primary">Register</button>
</form>
