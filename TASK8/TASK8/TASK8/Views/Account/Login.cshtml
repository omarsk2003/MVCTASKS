@model TASK8.Models.LoginDTO
@{ ViewData["Title"] = "Login"; }
<h2>Login</h2>
<form asp-controller="Account" asp-action="Login" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label class="form-label">Email</label>
    <input asp-for="Email" class="form-control mb-3" />
    <label class="form-label">Password</label>
    <input asp-for="Password" class="form-control mb-3" />
    <label class="form-label">Remember Me</label>
    <input asp-for="RememberMe" type="checkbox" class="form-check-input ms-2 mb-3" />
    <div><button type="submit" class="btn btn-primary">Login</button></div>
</form>
