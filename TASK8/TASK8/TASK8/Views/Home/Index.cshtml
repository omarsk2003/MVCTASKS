@{
    ViewData["Title"] = "Home";
}
<h1>University Cafeteria Supply Requests</h1>
<p>Request cafeteria products and track approval status.</p>
@if (User.Identity?.IsAuthenticated == true)
{
    <a class="btn btn-primary" asp-controller="SupplyRequest" asp-action="Create">New Supply Request</a>
    <a class="btn btn-outline-primary" asp-controller="SupplyRequest" asp-action="Index">My / All Requests</a>
    <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">View Products</a>
}
else
{
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
    <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Login</a>
}
