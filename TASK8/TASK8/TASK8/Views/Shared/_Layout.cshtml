<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafeteria Supply</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-4">
<div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">Cafeteria Supply</a>
    <div class="navbar-nav me-auto">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="nav-link" asp-controller="Product" asp-action="Index">Products</a>
            <a class="nav-link" asp-controller="SupplyRequest" asp-action="Index">Supply Requests</a>
            @if (User.IsInRole("SuperAdmin"))
            {
                <a class="nav-link" asp-controller="Admin" asp-action="Index">Manage Users</a>
            }
        }
    </div>
    <div class="navbar-nav align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span class="navbar-text me-3">Hello @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button>
        </form>
    }
    else
    {
        <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
    }
    </div>
</div>
</nav>
</header>
<div class="container pb-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }
    <main>@RenderBody()</main>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
