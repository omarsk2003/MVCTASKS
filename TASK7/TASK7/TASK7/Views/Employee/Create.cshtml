@{
}
@model TASK7.Models.Employee

<form asp-action="Create" method="post">
    <input type="text" asp-for="FullName" placeholder="FullName" />
    <input type="text" asp-for="Phone" placeholder="Phone" />
    <input type="email" asp-for="Email" placeholder="Email" />
    <input type="text" asp-for="Position" placeholder="Position" />

    <input type="number" step="any" asp-for="Salary" placeholder="Salary" />
    <input type="date" asp-for="HireDate" />

    <button type="submit">Create</button>
</form>